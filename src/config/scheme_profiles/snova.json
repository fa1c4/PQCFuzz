  },
  "source": {
    "project_id": "snova",
    "implementation_id": "snova_reference",
    "reference_version": "nist-round2-13182903755ade177e02d1fea77f0bd2e1e1a280",
    "vendored_path": "projects/SNOVA/reference",
    "build_model": "one parameter set and backend per translation unit set; profiles are selected with -D v_SNOVA/o_SNOVA/l_SNOVA, -D PK_EXPAND_SHAKE=0|1, -D sk_is_seed=0|1, -D OPTIMISATION=0 -D FIXED_ABQ=2"
  },
  "api": {
    "keygen": "crypto_sign_keypair",
    "sign": "crypto_sign (NIST signed-message form: signature = first CRYPTO_BYTES bytes)",
    "verify": "crypto_sign_open (length parameter counts signature plus message)",
    "digest_sign": "sign_digest_ssk|sign_digest_esk(digest, 64, salt, sk)",
    "digest_verify": "verify_signture(digest, 64, signature, pk)",
    "keygen_seeded": "generate_keys_ssk|generate_keys_esk(pk, sk, pkseed[16], skseed[32])",
    "expanded_key_pk": "generate_pk_with_esk|generate_pk_with_ssk",
    "expand_public": "expand_public_pack"
  },
  "hash": {
    "message_digest": "SHAKE256(message) squeezed to 64 bytes before signing",
    "target_hash": "SHAKE256(public_key_seed || digest || salt) squeezed to bytes_hash",
    "private_seed_expansion": "T12 = SHAKE256(private_seed) (32-byte seed input); per-retry vinegar = SHAKE256(private_seed || digest || salt || uint8_le(num_sign)); num_sign is a per-signature retry counter that starts at 1 and increments on every Gauss redo",
    "pk_expand_aes": "AES-128-CTR with the 16-byte public seed as the key and a zero nonce; counter convention locked by the pinned source/KAT",
    "pk_expand_shake": "indexed SHAKE128: block_i = SHAKE128(public_seed || LE64(i), rate 168), stream = block_0 || block_1 || ...",
    "fixed_abq": "SHAKE256(\"SNOVA ABQ\") expansion used for l <= 3; independent of the public seed",
    "note": "SNOVA_SHAKE is not a plain continuous SHAKE128 stream"
  },
  "capabilities": {
    "supports_context": false,
    "supports_seeded_sign": true,
    "supports_deterministic_sign": false,
    "verify_checks_length": true,
    "sign_accepts_extended_context": false,
    "verify_accepts_extended_context": false,
    "secret_key_formats": [
      "SSK",
      "ESK"
    ],
    "pk_expand_backends": [
      "AES",
      "SHAKE"
    ]
  },
  "serialization": {
    "public_key": "spublic[16] || P22 (low-nibble-first nibble stream, zero-filled high nibble when odd)",
    "signature": "U (n matrices, low-nibble-first nibble stream) || salt[16]; pad nibble belongs to the last data byte before salt",
    "ssk": "public_seed[16] || private_seed[32]",
    "esk": "cut-in-half nibble packing of A|B|Q1|Q2|T12|F11|F12|F21 matrices followed by public_seed[16] || private_seed[32]",
    "gf16_polynomial": "x^4 + x + 1; addition is XOR; multiplication is polynomial reduction (not integer mod 16)",
    "nibble_order": "low nibble first; an odd nibble count pads the high nibble of the final data byte with zero"
  },
