    "build_model": "one parameter set per translation-unit set; the internal functions are not namespaced, so each NTRU parameter set is compiled separately with -DCRYPTO_NAMESPACE(s)=ntru_##s and linked into the per-algorithm adapter/test binary"
  },
  "api": {
    "keygen": "crypto_kem_keypair (randombytes consumes NTRU_SAMPLE_FG_BYTES then 32 prf-key bytes)",
    "encaps": "crypto_kem_enc (randombytes consumes NTRU_SAMPLE_RM_BYTES)",
    "decaps": "crypto_kem_dec (implicit rejection: SHA3-256(prf_key || c) is the fail secret)",
    "dpke_decrypt": "owcpa_dec (test-only hook; returns fail and the packed r||m)"
  },
  "hash": {
    "function": "SHA3-256 for ss_valid = SHA3-256(pack_S3(r)||pack_S3(m)) and ss_invalid = SHA3-256(prf_key||ct)",
    "note": "BoringSSL HRSS uses SHA-256; it is not exchangeable with this SHA3-256 profile"
  },
  "capabilities": {
    "supports_context": false,
    "supports_seeded_sign": false,
    "supports_deterministic_sign": false,
    "verify_checks_length": false,
    "sign_accepts_extended_context": false,
    "verify_accepts_extended_context": false,
    "ct_padding_policy": "strict_checked",
    "ct_padding_evidence": "ENGINEERING_RECOMMENDATION"
  },
  "layout": {
    "pk": "pack_Rq0(h)[0,Bq); coefficient n-1 is reconstructed so the sum is 0 mod q",
    "ct": "pack_Rq0(c)[0,Bq); unused high bits of the final byte must be zero",
    "sk": "pack_S3(f)[0,B3) || pack_S3(fp)[B3,2B3) || pack_Sq(hq)[2B3,2B3+Bq) || prf_key[2B3+Bq,2B3+Bq+32)",
    "packed_rm": "pack_S3(r)||pack_S3(m), 2*B3 bytes",
    "packing_order": "little-endian bit packing: coefficient i occupies bits [i*logq,(i+1)*logq) of the byte stream; S3 packs 5 base-3 digits per byte with coefficient 5i as the least significant digit"
  },
