{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pqcfuzz.local/schemas/structured_input.schema.json",
  "type": "object",
  "required": [
    "magic",
    "version",
    "algorithm",
    "oracle_id",
    "flags",
    "seed_len",
    "msg_len",
    "mutation_len",
    "extra_len"
  ],
  "properties": {
    "magic": {
      "const": "PQCF"
    },
    "version": {
      "type": "integer"
    },
    "algorithm": {
      "enum": [
        "ML-KEM-512",
        "ML-KEM-768",
        "ML-KEM-1024",
        "ML-DSA-44",
        "ML-DSA-65",
        "ML-DSA-87",
        "SLH-DSA-SHA2-128s",
        "SLH-DSA-SHAKE-128s",
        "SLH-DSA-SHA2-128f",
        "SLH-DSA-SHAKE-128f",
        "SLH-DSA-SHA2-192s",
        "SLH-DSA-SHAKE-192s",
        "SLH-DSA-SHA2-192f",
        "SLH-DSA-SHAKE-192f",
        "SLH-DSA-SHA2-256s",
        "SLH-DSA-SHAKE-256s",
        "SLH-DSA-SHA2-256f",
        "SLH-DSA-SHAKE-256f",
        "AIGIS-ENC-1",
        "AIGIS-ENC-2",
        "AIGIS-ENC-3",
        "AIGIS-ENC-4",
        "AIGIS-SIG-1",
        "AIGIS-SIG-2",
        "AIGIS-SIG-3",
        "NTRU-HPS-2048-509",
        "NTRU-HPS-2048-677",
        "NTRU-HPS-4096-821",
        "NTRU-HRSS-701",
        "FALCON-512-COMPRESSED",
        "FALCON-1024-COMPRESSED",
        "FALCON-512-PADDED",
        "FALCON-1024-PADDED",
        "FALCON-512-CT",
        "FALCON-1024-CT",
        "CROSS-RSDP-1-FAST",
        "CROSS-RSDP-1-BALANCED",
        "CROSS-RSDP-1-SMALL",
        "CROSS-RSDP-3-FAST",
        "CROSS-RSDP-3-BALANCED",
        "CROSS-RSDP-3-SMALL",
        "CROSS-RSDP-5-FAST",
        "CROSS-RSDP-5-BALANCED",
        "CROSS-RSDP-5-SMALL",
        "CROSS-RSDPG-1-FAST",
        "CROSS-RSDPG-1-BALANCED",
        "CROSS-RSDPG-1-SMALL",
        "CROSS-RSDPG-3-FAST",
        "CROSS-RSDPG-3-BALANCED",
        "CROSS-RSDPG-3-SMALL",
        "CROSS-RSDPG-5-FAST",
        "CROSS-RSDPG-5-BALANCED",
        "CROSS-RSDPG-5-SMALL"
      ]
    },
    "oracle_id": {
      "type": "string"
    },
    "flags": {
      "type": "integer"
    }
  }
}
