{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pqcfuzz.local/schemas/oracle_spec.schema.json",
  "type": "object",
  "required": [
    "oracles"
  ],
  "properties": {
    "oracles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "oracle_id",
          "algorithm_family",
          "primitive_type",
          "claim",
          "evidence_class",
          "source_reference"
        ],
        "properties": {
          "oracle_id": {
            "type": "string"
          },
          "algorithm_family": {
            "enum": [
              "ML-KEM",
              "ML-DSA",
              "SLH-DSA",
              "AIGIS-ENC",
              "AIGIS-SIG",
              "CROSS"
            ]
          },
          "primitive_type": {
            "enum": [
              "kem",
              "sig"
            ]
          },
          "api_surface": {
            "type": "array",
            "items": {
              "enum": [
                "keygen",
                "encaps",
                "decaps",
                "sign",
                "verify"
              ]
            }
          },
          "precondition": {
            "type": "object"
          },
          "mutation": {
            "type": "object"
          },
          "expected_relation": {
            "type": "string"
          },
          "comparator": {
            "type": "string"
          },
          "triage_policy": {
            "type": "string"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "enum": [
              "NORMATIVE",
              "REFERENCE_DERIVED",
              "IMPLEMENTATION_OBSERVED",
              "ENGINEERING_RECOMMENDATION",
              "INFERENCE"
            ]
          },
          "source_reference": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object",
            "properties": {
              "api_layer": {
                "enum": [
                  "external",
                  "internal",
                  "component",
                  "parser",
                  "primitive"
                ]
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditional_verdict": {
            "type": "string"
          },
          "controls": {
            "type": "object",
            "properties": {
              "positive_control": {
                "type": "string"
              },
              "negative_control": {
                "type": "string"
              }
            }
          },
          "enabled_by_default": {
            "type": "boolean"
          },
          "requires_api": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "finding_subclass": {
            "type": "string"
          },
          "requires_rng_injection": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
