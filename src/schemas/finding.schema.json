{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pqcfuzz.local/schemas/finding.schema.json",
  "type": "object",
  "required": [
    "version",
    "oracle_semantics_version",
    "evidence_kind",
    "evidence_class",
    "verdict",
    "conditional_verdict",
    "claim",
    "source_reference",
    "limitations",
    "finding_id",
    "job_id",
    "pair_id",
    "algorithm",
    "oracle_id",
    "finding_class",
    "finding_subclass",
    "summary",
    "fingerprint",
    "trace_path",
    "artifact_dir",
    "validation_state",
    "validated",
    "validation_attempts",
    "validation_failure_reason"
  ],
  "properties": {
    "version": {
      "const": 5
    },
    "oracle_semantics_version": {
      "const": 5
    },
    "evidence_kind": {
      "enum": ["semantic", "sanitizer", "process"]
    },
    "evidence_class": {
      "enum": [
        "NORMATIVE",
        "REFERENCE_DERIVED",
        "IMPLEMENTATION_OBSERVED",
        "ENGINEERING_RECOMMENDATION",
        "INFERENCE"
      ]
    },
    "verdict": {
      "enum": [
        "CONFORMANT",
        "NONCONFORMANT",
        "HARDENING_GAP",
        "NO_COUNTEREXAMPLE",
        "INCONCLUSIVE",
        "NOT_APPLICABLE",
        "HARNESS_ERROR"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "finding_class": {
      "enum": [
        "malleability",
        "non_malleability",
        "crash",
        "hang",
        "confirmed_semantic_bug",
        "potential_crypto_vuln",
        "memory_safety",
        "ub",
        "timeout",
        "api_policy_difference"
      ]
    },
    "validated": {
      "type": "boolean"
    },
    "validation_state": {
      "enum": ["raw", "validated", "invalidated"]
    },
    "validation_attempts": {
      "type": "integer",
      "minimum": 0
    }
  }
}
